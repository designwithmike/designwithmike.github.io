---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import WorkCard from '../../components/WorkCard.astro';
import Icon from '../../components/Icon.astro';
import { site, projects } from '../../data/site';
import type { Project } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

/* "More projects" shows two other projects. Finished case studies (ones with
   a real hero to use as the cover) come first, then the rest in list order,
   starting after this one and wrapping around at the end. */
const index = projects.findIndex((p) => p.slug === project.slug);
const hasCover = (p: Project) => {
  const hero = p.sections[0];
  return (hero?.type === 'image' || hero?.type === 'phones') && !!hero.frame;
};
const others = projects
  .map((_, step) => projects[(index + 1 + step) % projects.length])
  .filter((p) => p.slug !== project.slug);
const more = [...others.filter(hasCover), ...others.filter((p) => !hasCover(p))].slice(0, 2);
/* the still frame saved next to each clip (same name, .jpg), shown until
   the video plays and to anything that can't play video */
const poster = (src: string) => src.split('#')[0].replace(/\.mp4$/, '.jpg');
---

<Base title={project.title} description={project.summary} image={`/og/${project.slug}.jpg`}>
  <!-- the serif used on the home page (Zodiak Thin), for the headline -->
  <Fragment slot="head">
    <link href="https://api.fontshare.com/v2/css?f[]=zodiak@100&display=swap" rel="stylesheet" />
  </Fragment>
  <main class="case wrap" style={`--hue:${project.hue}`}>
    <!-- Back to the home page -->
    <div class="back">
      <a class="label link" href="/">← Back</a>
    </div>

    <!-- Summary: label on the left, big statement and fact rows on the right -->
    <section class="row summary">
      <div class="row__side"><span class="label">Summary</span></div>
      <div class="row__main">
        <h1 class="h2-serif summary__text">{project.summary}</h1>
        <dl class="facts">
          {
            project.details.map((d) => (
              <div class="facts__row label">
                <dt>{d.label}</dt>
                <dd>{d.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- The story: text chapters with images between them -->
    {
      project.sections.map((s) => {
        if (s.type === 'image' && s.frame && (s.video || s.image)) {
          const mediaStyle = `aspect-ratio:${s.mediaRatio ?? '16 / 10'}${s.mediaWidth ? `;width:${s.mediaWidth}` : ''}`;
          return (
            <section class="media">
              <div class="framed" style={`aspect-ratio:${s.ratio ?? '3 / 2'};background-image:url(${s.frame})`}>
                {s.video ? (
                  <video
                    class="framed__media"
                    src={s.video}
                    poster={poster(s.video)}
                    style={mediaStyle}
                    aria-label={s.label}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                  />
                ) : (
                  <img class="framed__media" src={s.image} alt={s.label} loading="lazy" style={mediaStyle} />
                )}
              </div>
            </section>
          );
        }
        if (s.type === 'image') {
          return (
            <section class="media">
              {s.video ? (
                <video
                  class="media__video"
                  src={s.video}
                  poster={poster(s.video)}
                  style={`aspect-ratio:${s.ratio ?? '16 / 9'}`}
                  aria-label={s.label}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                />
              ) : s.image ? (
                <img
                  class="media__img"
                  src={s.image}
                  alt={s.label}
                  loading="lazy"
                  style={`aspect-ratio:${s.ratio ?? '16 / 9'}`}
                />
              ) : (
                <div class="ph" style={`aspect-ratio:${s.ratio ?? '16 / 9'}`}>
                  <span class="label">{s.label}</span>
                </div>
              )}
            </section>
          );
        }
        if (s.type === 'phones') {
          return (
            <section class="media">
              <div
                class:list={['phones', { 'phones--framed': s.frame, 'phones--labelled': s.phones.some((p) => p.label) }]}
                style={`--n:${s.phones.length};--w:${s.phones.length >= 4 ? 15.5 : 17.5}%;background-image:url(${s.background})`}
              >
                {s.phones.map((p) =>
                  s.frame ? (
                    // a bare screen (or screen recording) placed inside the empty phone frame,
                    // with an optional label (like Before / After) above it
                    <div class="phones__item">
                    {p.label && <span class="label chip chip--light pc__label">{p.label}</span>}
                    <div class="pc__phone">
                      <div class="pc__screen">
                        {p.src.endsWith('.mp4') ? (
                          <video
                            class="pc__shot"
                            src={p.src}
                            poster={poster(p.src)}
                            aria-label={p.alt}
                            autoplay
                            muted
                            loop
                            playsinline
                            preload="metadata"
                          />
                        ) : (
                          <img class="pc__shot" src={p.src} alt={p.alt} loading="lazy" />
                        )}
                      </div>
                      <img class="pc__frame" src={s.frame} alt="" loading="lazy" />
                    </div>
                    </div>
                  ) : (
                    <img class="phones__img" src={p.src} alt={p.alt} loading="lazy" width="397" height="810" />
                  ),
                )}
              </div>
            </section>
          );
        }
        if (s.type === 'phone-compare') {
          return (
            <section class="media">
              <div class="pc" style={`background-image:url(${s.background})`}>
                <div class="pc__group pc__group--before">
                  <span class="label chip chip--light pc__label">Before</span>
                  <div class="pc__device">
                    <div class="pc__phone">
                      <div class="pc__screen">
                        <img class="pc__shot pc__shot--scroll" src={s.before.src} alt={s.before.alt} loading="eager" />
                      </div>
                      <img class="pc__frame" src={s.frame} alt="" loading="eager" />
                    </div>
                  </div>
                </div>
                <div class="pc__group pc__group--after">
                  <span class="label chip chip--light pc__label">After</span>
                  <div class="pc__device">
                    <div class="pc__phone">
                      <div class="pc__screen">
                        <img class="pc__shot" src={s.after[0].src} alt={s.after[0].alt} loading="eager" />
                        <img class="pc__shot pc__shot--next" src={s.after[1].src} alt={s.after[1].alt} loading="eager" />
                      </div>
                      <img class="pc__frame" src={s.frame} alt="" loading="eager" />
                    </div>
                    <span class="pc__dots">
                      <button class="pc__step" type="button" data-step="0" aria-label="Show the first screen">
                        <span class="pc__dot pc__dot--1" />
                      </button>
                      <button class="pc__step" type="button" data-step="1" aria-label="Show the second screen">
                        <span class="pc__dot pc__dot--2" />
                      </button>
                    </span>
                  </div>
                </div>
              </div>
            </section>
          );
        }
        if (s.type === 'phone-slider') {
          return (
            <section class="media">
              {/* Phones in a row with one before/after wipe across all of them.
                  Each screen trims its own before and after at the handle. */}
              <div
                class="phones phones--framed compare ps"
                style={`--n:${s.phones.length};--w:${s.phones.length >= 4 ? 15.5 : 17.5}%;background-image:url(${s.background})`}
              >
                {s.phones.map((p) => (
                  <div class="pc__phone">
                    <div class="pc__screen ps__screen">
                      <img
                        class="pc__shot ps__after"
                        style={p.afterAnchor === 'bottom' ? 'object-position:50% 100%' : undefined}
                        src={p.after}
                        alt={`After: ${p.alt}`}
                        loading="lazy"
                      />
                      <img class="pc__shot ps__before" src={p.before} alt={`Before: ${p.alt}`} loading="lazy" />
                    </div>
                    <img class="pc__frame" src={s.frame} alt="" loading="lazy" />
                  </div>
                ))}
                {/* Each chip sits in a full-size layer trimmed at the handle, so
                    it disappears as the handle passes over it, like the images */}
                <div class="compare__layer compare__before ps__chips" aria-hidden="true">
                  <span class="label chip chip--light">Before</span>
                </div>
                <div class="compare__layer compare__after ps__chips" aria-hidden="true">
                  <span class="label chip chip--light chip--right">After</span>
                </div>
                <div class="compare__handle" aria-hidden="true">
                  <span class="compare__hint">Drag to compare</span>
                  <span class="compare__knob">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9 6l-5 6 5 6M15 6l5 6-5 6" />
                    </svg>
                  </span>
                </div>
                <input
                  class="compare__range"
                  type="range"
                  min="0"
                  max="100"
                  value="50"
                  step="0.1"
                  aria-label="Drag to compare before and after"
                />
              </div>
            </section>
          );
        }
        if (s.type === 'compare') {
          const [beforeLabel, afterLabel] = s.labels ?? ['Before', 'After'];
          return (
            <section class="media">
              <div class="compare" style={`aspect-ratio:${s.ratio ?? '3 / 2'}`}>
                {/* Each side is a layer holding its image and its chip, trimmed at
                    the handle, so a chip disappears along with its image */}
                <div class="compare__layer compare__after">
                  <img class="compare__img" src={s.after} alt={afterLabel} />
                  <span class="label chip chip--light chip--right">{afterLabel}</span>
                </div>
                <div class="compare__layer compare__before">
                  <img class="compare__img" src={s.before} alt={beforeLabel} />
                  <span class="label chip chip--light">{beforeLabel}</span>
                </div>
                <div class="compare__handle" aria-hidden="true">
                  <span class="compare__hint">Drag to compare</span>
                  <span class="compare__knob">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9 6l-5 6 5 6M15 6l5 6-5 6" />
                    </svg>
                  </span>
                </div>
                {/* An invisible slider over the whole image does the dragging,
                    so it also works with the keyboard and screen readers */}
                <input
                  class="compare__range"
                  type="range"
                  min="0"
                  max="100"
                  value="50"
                  step="0.1"
                  aria-label={`Drag to compare ${beforeLabel.toLowerCase()} and ${afterLabel.toLowerCase()}`}
                />
              </div>
            </section>
          );
        }
        if (s.type === 'framed-pair') {
          return (
            <section class="media media--pair">
              {s.items.map((it) => (
                <div class="framed" style={`aspect-ratio:${s.ratio ?? '3 / 2'};background-image:url(${it.frame})`}>
                  <img
                    class="framed__media"
                    src={it.image}
                    alt={it.label}
                    loading="lazy"
                    style={`aspect-ratio:${it.mediaRatio}`}
                  />
                </div>
              ))}
            </section>
          );
        }
        if (s.type === 'image-pair') {
          return (
            <section class="media media--pair">
              {s.labels.map((label, i) => (
                <figure class="pair__item">
                  {s.images?.[i] ? (
                    <img
                      class="media__img"
                      src={s.images[i]}
                      alt={label}
                      loading="lazy"
                      style={`aspect-ratio:${s.ratio ?? '4 / 5'}`}
                    />
                  ) : (
                    <div class="ph" style={`aspect-ratio:${s.ratio ?? '4 / 5'}`} />
                  )}
                  {/* the label sits on the image as a see-through chip */}
                  <figcaption class="label chip">{label}</figcaption>
                </figure>
              ))}
            </section>
          );
        }
        if (s.type === 'stats') {
          return (
            <section class="chapter">
              <div class="chapter__body">
                <h3 class="label chapter__label">{s.heading}</h3>
                {s.paragraphs?.map((p) => (
                  <p class="body">{p}</p>
                ))}
                <div class="stats">
                  {s.items.map((item) => (
                    <div class="stat">
                      <span class="stat__value">
                        {item.value.split('→').map((part, i) => (
                          <>
                            {i > 0 && <span class="stat__arrow">→</span>}
                            {part.trim()}
                          </>
                        ))}
                      </span>
                      <span class="stat__label">{item.label}</span>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          );
        }
        if (s.type === 'titled') {
          return (
            <section class="chapter">
              <h2 class="h2 offset-title">{s.title}</h2>
              <div class="chapter__body chapter__cols">
                {s.columns.map((col) => (
                  <div>
                    <h3 class="label chapter__label">{col.heading}</h3>
                    {col.paragraphs.map((p) => (
                      <p class="body">{p}</p>
                    ))}
                  </div>
                ))}
              </div>
            </section>
          );
        }
        return (
          <section class:list={['chapter', { 'chapter--sub': s.sub }]}>
            <div class="chapter__body">
              <h3 class="label chapter__label">{s.heading}</h3>
              {s.paragraphs.map((p) => (
                <p class="body">{p}</p>
              ))}
              {s.stats && (
                <div class="stats stats--inline">
                  {s.stats.map((item) => (
                    <div class="stat">
                      <span class="stat__value">
                        {item.value.split('→').map((part, i) => (
                          <>
                            {i > 0 && <span class="stat__arrow">→</span>}
                            {part.trim()}
                          </>
                        ))}
                      </span>
                      <span class="stat__label">{item.label}</span>
                    </div>
                  ))}
                </div>
              )}
              {s.points && (
                <ul class="points" style={`--n:${s.pointColumns ?? s.points.length}`}>
                  {s.points.map((pt) => (
                    <li class="point">
                      <span class="point__icon">
                        <Icon name={pt.icon} size={22} />
                      </span>
                      <h4 class="point__title">{pt.title}</h4>
                      <p class="point__text">{pt.text}</p>
                    </li>
                  ))}
                </ul>
              )}
              {s.divider && <hr class="chapter__rule" />}
            </div>
          </section>
        );
      })
    }

    <!-- Link to the live design, after the story and before the callout -->
    {
      project.live && (
        <section class="chapter">
          <div class="chapter__body live">
            <a class="link live__link" href={project.live.href} target="_blank" rel="noopener">
              {project.live.label ?? 'See the live design on LG.com'} ↗
            </a>
            {project.live.note && <span class="live__note"> ({project.live.note})</span>}
          </div>
        </section>
      )
    }

    <!-- Closing callout: invite a full walkthrough -->
    <section class="chapter">
      <div class="chapter__body cta">
        <p class="body">{site.caseStudyCta}</p>
        <a class="link cta__email" href={`mailto:${site.email}`} data-copy={site.email}>{site.email}</a>
      </div>
    </section>

    <!-- More projects -->
    <section class="row more">
      <div class="row__side">
        <h2 class="more__heading">
          <span class="h1">More</span><br />
          <span class="h1-serif">Projects</span>
        </h2>
      </div>
      <div class="row__main more__grid">
        {more.map((p) => <WorkCard project={p} ratio="1 / 1" />)}
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  /* Before/after slider: move the wipe line to wherever the slider is */
  document.querySelectorAll<HTMLElement>('.compare').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('.compare__range');
    if (!range) return;
    const screens = el.querySelectorAll<HTMLElement>('.ps__screen');
    const update = () => {
      el.style.setProperty('--pos', `${range.value}%`);
      // Phone slider: tell each screen how far the handle is into it
      if (!screens.length) return;
      const box = el.getBoundingClientRect();
      const x = box.left + (box.width * Number(range.value)) / 100;
      screens.forEach((screen) => {
        const r = screen.getBoundingClientRect();
        screen.style.setProperty('--clip', `${Math.min(Math.max(x - r.left, 0), r.width)}px`);
      });
    };
    /* Start in the middle, half Before and half After, so the new work is
       on screen even for someone who never drags. */
    let touched = false;
    const restPosition = () => 50;
    const setPos = (v: number) => {
      range.value = String(v);
      update();
    };

    /* The nudge: once the slider is mostly in view, the handle glides over to
       show more of the After, then back to the middle, so it's clear it moves. It plays once, stops the moment
       someone grabs the slider, and is skipped for reduced motion. */
    const nudge = () => {
      const rest = restPosition();
      const peek = 30;
      const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
      const steps = [
        { from: rest, to: peek, ms: 900 },
        { from: peek, to: peek, ms: 300 },
        { from: peek, to: rest, ms: 900 },
      ];
      let i = 0;
      let start = performance.now();
      const frame = (now: number) => {
        if (touched) return;
        const s = steps[i];
        const t = Math.min((now - start) / s.ms, 1);
        setPos(s.from + (s.to - s.from) * ease(t));
        if (t < 1) return requestAnimationFrame(frame);
        if (++i < steps.length) {
          start = now;
          requestAnimationFrame(frame);
        }
      };
      requestAnimationFrame(frame);
    };

    const markTouched = () => {
      touched = true;
      el.classList.add('is-touched'); // fades the "Drag to compare" hint
    };
    range.addEventListener('pointerdown', markTouched);
    range.addEventListener('keydown', markTouched);
    range.addEventListener('input', () => {
      markTouched();
      update();
    });
    window.addEventListener('resize', update);
    setPos(restPosition());

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const seen = new IntersectionObserver(
        (entries) => {
          if (!entries[0].isIntersecting) return;
          seen.disconnect();
          setTimeout(() => !touched && nudge(), 400);
        },
        { threshold: 0.6 },
      );
      seen.observe(el);
    }
  });

  /* Mobile After phone: clicking a timer bar jumps to that screen. Each
     screen is 3 seconds, so screen 2 starts 3 seconds into the loop. */
  document.querySelectorAll<HTMLElement>('.pc__group--after').forEach((group) => {
    group.querySelectorAll<HTMLButtonElement>('.pc__step').forEach((btn) => {
      btn.addEventListener('click', () => {
        const step = Number(btn.dataset.step);
        const anims = group.getAnimations({ subtree: true });
        anims.forEach((a) => (a.currentTime = step * 3000));
        group.classList.toggle('is-step-2', anims.length === 0 && step === 1);
      });
    });
  });
</script>

<style>
  /* Content is capped at 1080px wide and centred; the side gutters sit
     outside that, so images are never wider than 1080px. */
  .case {
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin-inline: auto;
  }

  /* "← Back" sits in a 64px strip at the top, where the nav used to be */
  .back {
    display: flex;
    align-items: center;
    height: 64px;
    margin-bottom: 32px;
  }

  /* Placeholder images: a plain box a shade darker than the page background,
     until real visuals are dropped in */
  .case :global(.ph) {
    background: #dde2e2;
    color: var(--ink-soft);
  }

  /* ----- Summary ----- */
  /* same serif as the home page bio */
  .summary__text {
    font-family: 'Zodiak', Georgia, serif;
    font-weight: 100; /* Zodiak Thin */
  }

  .facts {
    margin: 28px 0 0;
    border-top: 1px solid var(--rule);
  }

  .facts__row {
    display: flex;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }

  .facts__row dt {
    flex: 0 0 50%;
  }

  .facts__row dd {
    margin: 0;
  }

  /* ----- Chapters ----- */
  .chapter {
    padding-top: 80px;
  }

  .chapter .offset-title {
    padding-bottom: 60px;
  }

  .chapter__body {
    padding-left: calc(var(--side) + 30px);
  }

  .chapter__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }

  /* Section headings ("The problem", "Mobile"...): normal case, a step up
     from the 18px body so they read as titles rather than small labels */
  .chapter__label {
    font-size: 24px;
    line-height: 32px;
    font-weight: 400;
    letter-spacing: -0.01em;
    text-transform: none;
    margin-bottom: 12px;
  }

  /* Hairline under an overview, separating it from the steps below */
  .chapter__rule {
    margin: 48px 0 0;
    border: 0;
    border-top: 1px solid var(--rule);
  }

  /* A step inside a chapter (one change and what it did): smaller heading,
     closer to the chapter above it */
  .chapter--sub {
    padding-top: 56px;
  }

  .chapter--sub .chapter__label {
    font-size: 20px;
    line-height: 28px;
  }

  /* Numbers that sit right under a step's paragraph: a bit smaller than
     the Results ones */
  .stats--inline {
    margin-top: 24px;
  }

  .stats--inline .stat__value {
    font-size: clamp(26px, 3vw, 40px);
  }

  /* ----- Callouts: all in one row under a paragraph (two per row on
     tablets, stacked on phones), icon then a short title and line ----- */
  .points {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr));
    gap: 0 20px;
    margin: 30px 0 0;
    padding: 0;
  }

  .point {
    padding: 0 0 24px;
  }

  .point__icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 14px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink);
  }

  .point__title {
    margin: 0 0 2px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 400;
  }

  .point__text {
    font-size: 14px;
    line-height: 20px;
    font-weight: 300;
    color: var(--ink); /* same colour as the paragraphs above */
  }

  @media (max-width: 1100px) {
    .points {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .points {
      grid-template-columns: 1fr;
    }
  }

  /* ----- Stats: big numbers stacked as rows inside the text column,
     number on the left, label on the right, hairlines between ----- */
  .stats {
    margin-top: 30px;
    border-bottom: 1px solid var(--rule);
  }

  .stat {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: end;
    gap: 30px;
    padding: 18px 0 20px;
    border-top: 1px solid var(--rule);
  }

  .stat__value {
    /* up to 52px on big screens */
    font-size: clamp(28px, 3.5vw, 52px);
    line-height: 1;
    white-space: nowrap;
    font-family: 'Zodiak', Georgia, serif; /* same serif as the headline */
    font-weight: 100; /* Zodiak Thin */
    letter-spacing: -0.03em;
  }

  /* the arrow in "13.5% → 33%" is smaller and lighter so the numbers lead */
  .stat__arrow {
