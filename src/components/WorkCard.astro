---
import type { Project } from '../data/site';
import ProjectCover from './ProjectCover.astro';

interface Props {
  project: Project;
  ratio?: string;
}

const { project, ratio = '16 / 9' } = Astro.props;
---

<a class="card" href={`/work/${project.slug}`}>
  <div class="card__media">
    <ProjectCover project={project} ratio={ratio} />
  </div>
  <h3 class="card__title">{project.title}</h3>
  {/* just the year as a tag, like the home page cards */}
  <div class="tags">
    <span class="tag">{project.year}</span>
  </div>
</a>
